{
  "name": "skillverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend:dev": "node --watch backend/server.js",
    "backend:start": "node backend/server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
